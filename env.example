# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Jira Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your_jira_username
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ

# Git Configuration
GIT_REPO_URL=https://github.com/your-org/your-repo.git
GIT_BRANCH=main
GIT_ACCESS_TOKEN=your_git_access_token

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/smarter_case
REDIS_URL=redis://localhost:6379/0

# CI/CD Configuration
GITHUB_ACTIONS_TOKEN=your_github_token
JENKINS_URL=http://localhost:8080
JENKINS_USERNAME=your_jenkins_username
JENKINS_API_TOKEN=your_jenkins_token

# Test Framework Configuration
PYTEST_CONFIG_PATH=./pytest.ini
PLAYWRIGHT_CONFIG_PATH=./playwright.config.js
TEST_CASES_DB_PATH=./data/test_cases/test_cases.json

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/application.log

# Performance Configuration
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT=300
CACHE_TTL=3600

# Security Configuration
SECRET_KEY=your_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# Monitoring Configuration
PROMETHEUS_PORT=8000
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
